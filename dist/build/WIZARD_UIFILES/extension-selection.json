{
  "title": "PHP 8.3 Extension Selection",
  "description": "Choose the extensions to install. Dependencies toggle automatically.",
  "sections": [
    {
      "type": "list",
      "dataSource": "@@EXTENSION_OPTIONS@@",
      "itemTemplate": {
        "title": "${name}",
        "description": "${description}",
        "checkbox": {
          "binding": "extension.${id}",
          "default": "${defaultEnabled}"
        },
        "badges": [
          "${category}",
          "${restartRequirement}"
        ]
      },
      "emptyState": "No extensions available for this architecture."
    }
  ],
  "actions": {
    "next": {
      "text": "Continue",
      "validationScript": "extensionSelectionValidate"
    },
    "back": {
      "text": "Back"
    }
  }
}
